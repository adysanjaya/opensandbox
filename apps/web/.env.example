# ==========================================
# OpenSandbox - Web Frontend Environment Configuration
# ==========================================

# Backend API Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend Base URL (used for metadata, OG images, sitemap, and OAuth redirects)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Application Environment ('dev' or 'production')
NEXT_PUBLIC_APP_ENV=dev

# Optional Superadmin Email fallback for UI visibility
NEXT_PUBLIC_SUPERADMIN_EMAIL=admin@example.com

# Google OAuth Client ID (Optional - matching GOOGLE_CLIENT_ID in API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
