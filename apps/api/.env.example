# ==========================================
# OpenSandbox - API Environment Configuration
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox

# JWT Secret for Session Authentication (minimum 32 random characters recommended)
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-string

# API Server Port
PORT=4000

# Frontend Web Origin (Used for CORS and OAuth redirect)
WEB_URL=http://localhost:3000

# Superadmin Configuration
# The user with this email will automatically be assigned the 'admin' role upon registration / login
SUPERADMIN_EMAIL=admin@example.com

# Google OAuth (Optional - required only if enabling Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
