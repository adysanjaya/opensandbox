# ==============================================================
# OpenSandbox - Root Environment Reference & Docker Compose Config
# ==============================================================
# Copy this file or configure individual app environments:
#   apps/api/.env.example -> apps/api/.env
#   apps/web/.env.example -> apps/web/.env.local

# Database Configuration (Used by Docker Compose & API)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sandbox
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/sandbox

# Backend API Configuration
API_PORT=4000
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-string
SUPERADMIN_EMAIL=admin@example.com

# Frontend Web Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SUPERADMIN_EMAIL=admin@example.com

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
